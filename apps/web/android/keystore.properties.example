# Copy this file to `keystore.properties` (which is gitignored) and fill in
# your real values to sign the release AAB for the Google Play Store.
#
# Keep the .jks keystore file AND these passwords safe and backed up — with
# Play App Signing you can reset a lost upload key, but don't rely on it.
#
# storeFile is resolved relative to the app/ module (so this default expects
# the keystore at android/app/upload-keystore.jks).

storeFile=upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
