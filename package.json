{
  "name": "vaayu",
  "version": "0.1.0",
  "private": true,
  "description": "Vaayu — AI-powered artwork pricing engine (web + mobile monorepo)",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @vaayu/web dev",
    "dev:mobile": "pnpm --filter @vaayu/mobile start",
    "build:web": "pnpm --filter @vaayu/web build",
    "build:shared": "pnpm --filter @vaayu/shared build",
    "build:edge-shared": "esbuild packages/shared/src/index.ts --bundle --format=esm --platform=neutral --target=es2022 --legal-comments=none --banner:js=\"// AUTO-GENERATED from @vaayu/shared — do not edit. Regenerate with: pnpm build:edge-shared\" --outfile=supabase/functions/generate-valuation/_shared.ts",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "test": "pnpm -r test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "esbuild": "^0.24.2",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
