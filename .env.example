# =============================================================================
# Vaayu — environment variable reference (root)
# =============================================================================
# This is a REFERENCE of every secret the project uses. Real values live in
# per-app .env files (apps/web/.env, apps/mobile/.env) and in your server /
# Supabase Edge Function secrets. NEVER commit a real .env file.
#
# Naming rule:
#   - Web (Vite)   -> client-exposed vars MUST be prefixed VITE_
#   - Mobile (Expo)-> client-exposed vars MUST be prefixed EXPO_PUBLIC_
#   - Server-only secrets have NO prefix and must NEVER appear in client code.
# =============================================================================

# --- Supabase (public — safe in client) -------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-publishable-key
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-publishable-key

# --- Supabase (SERVER ONLY — never ship to a client bundle) ------------------
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Anthropic Claude (SERVER ONLY — used by the pricing Edge Function) ------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Razorpay (INR payments) -------------------------------------------------
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx          # public key id (client)
RAZORPAY_KEY_SECRET=your-razorpay-key-secret        # SERVER ONLY
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret # SERVER ONLY

# --- Stripe (USD / international payments) ------------------------------------
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx     # public key (client)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx               # SERVER ONLY
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx             # SERVER ONLY

# --- Resend (transactional email — SERVER ONLY) ------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxx
