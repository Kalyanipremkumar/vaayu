# Normalise line endings to LF in the repo, regardless of OS (we develop on
# Windows but CI runs on Linux). Prevents noisy CRLF diffs.
* text=auto eol=lf

# Binary assets — never normalise.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
